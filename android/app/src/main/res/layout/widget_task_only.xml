        <TextView android:id="@+id/task_title_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:paddingTop="7dp" android:paddingBottom="7dp" android:textSize="15sp" android:textStyle="bold" android:textColor="#2C1A0E" android:singleLine="true" android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout android:id="@+id/task_row_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_task_row_bg" android:layout_marginBottom="6dp">
        <ImageView android:id="@+id/task_accent_2" android:layout_width="4dp" android:layout_height="32dp" android:background="#f5a623" android:contentDescription="@null" />
