<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pet_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_background"
    android:padding="10dp">

    <LinearLayout android:id="@+id/pet_slot_0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_pet_slot_bg" android:padding="8dp" android:layout_marginEnd="4dp">
        <FrameLayout android:layout_width="40dp" android:layout_height="40dp">
            <ImageView android:id="@+id/pet_image_0" android:layout_width="40dp" android:layout_height="40dp" android:scaleType="centerInside" android:contentDescription="@null" />
            <TextView android:id="@+id/pet_badge_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:textSize="14sp" />
        </FrameLayout>
        <ProgressBar android:id="@+id/pet_mood_0" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="52dp" android:layout_height="wrap_content" android:minHeight="5dp" android:maxHeight="5dp" android:max="100" android:progressDrawable="@drawable/widget_progress_mood" android:layout_marginTop="4dp" />
        <ProgressBar android:id="@+id/pet_food_0" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="52dp" android:layout_height="wrap_content" android:minHeight="5dp" android:maxHeight="5dp" android:max="100" android:progressDrawable="@drawable/widget_progress_food" android:layout_marginTop="3dp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/pet_slot_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_pet_slot_bg" android:padding="8dp" android:layout_marginStart="4dp" android:layout_marginEnd="4dp">
        <FrameLayout android:layout_width="40dp" android:layout_height="40dp">
            <ImageView android:id="@+id/pet_image_1" android:layout_width="40dp" android:layout_height="40dp" android:scaleType="centerInside" android:contentDescription="@null" />
            <TextView android:id="@+id/pet_badge_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:textSize="14sp" />
        </FrameLayout>
        <ProgressBar android:id="@+id/pet_mood_1" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="52dp" android:layout_height="wrap_content" android:minHeight="5dp" android:maxHeight="5dp" android:max="100" android:progressDrawable="@drawable/widget_progress_mood" android:layout_marginTop="4dp" />
        <ProgressBar android:id="@+id/pet_food_1" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="52dp" android:layout_height="wrap_content" android:minHeight="5dp" android:maxHeight="5dp" android:max="100" android:progressDrawable="@drawable/widget_progress_food" android:layout_marginTop="3dp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/pet_slot_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_pet_slot_bg" android:padding="8dp" android:layout_marginStart="4dp">
        <FrameLayout android:layout_width="40dp" android:layout_height="40dp">
            <ImageView android:id="@+id/pet_image_2" android:layout_width="40dp" android:layout_height="40dp" android:scaleType="centerInside" android:contentDescription="@null" />
            <TextView android:id="@+id/pet_badge_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:textSize="14sp" />
        </FrameLayout>
        <ProgressBar android:id="@+id/pet_mood_2" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="52dp" android:layout_height="wrap_content" android:minHeight="5dp" android:maxHeight="5dp" android:max="100" android:progressDrawable="@drawable/widget_progress_mood" android:layout_marginTop="4dp" />
        <ProgressBar android:id="@+id/pet_food_2" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="52dp" android:layout_height="wrap_content" android:minHeight="5dp" android:maxHeight="5dp" android:max="100" android:progressDrawable="@drawable/widget_progress_food" android:layout_marginTop="3dp" />
    </LinearLayout>

</LinearLayout>